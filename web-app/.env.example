# Environment Variables for SCP Portal Web App

# API Configuration
VITE_API_ENDPOINT=http://localhost:1337

# Application Configuration
VITE_APP_NAME=SCP Portal
VITE_APP_VERSION=0.1.0

# Optional: Enable performance monitoring in production
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Optional: Analytics
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# Optional: Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_EXPERIMENTAL_FEATURES=false
